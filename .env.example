# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets or credentials.
#
# Settings are read automatically from .env by backend/app/config.py
# (pydantic-settings, env_file=".env") -- you don't need to export these by
# hand or pass them inline on the uvicorn command line.

# Paths can be relative to the repo root when the app starts there.
# IMAGES_DIR=../data
# INDEX_PATH=data/index.faiss
# IDS_PATH=data/ids.json
# REGION_INDEX_DIR=data/regions
# The text encoder must match data/index.faiss. For the SigLIP 2 index built by
# notebooks/Castle5000_SigLIP_Index.ipynb (Kaggle output castle5000_siglip2_index.zip):
# EMBED_MODEL_NAME=ViT-SO400M-16-SigLIP2-384
# EMBED_PRETRAINED=webli
# Login page offers "Demo" (built-in mock DRES, student / student) next to the real DRES.
# DRES_DEMO_ENABLED=true
# Số ảnh KIS tối đa được dò đối tượng cho mỗi truy vấn và thời gian tối đa (giây).
# Grounding DINO cho điều kiện đếm/loại trừ khi TÌM ẢNH (chậm trên CPU; QA luôn dùng DINO).
# SEARCH_DETECTION_ENABLED=false
# Số ảnh đầu Gemini tự kiểm sau mỗi lần tìm (4 = 1 lượt kiểm + tối đa 1 lượt phóng to).
# SEARCH_VERIFY_IMAGES=4
# DETECTION_MAX_IMAGES=50
# DETECTION_TIMEOUT_S=45
# Số luồng CPU cho Grounding DINO khi dò (0 = số nhân thật, tối đa 8; macOS luôn dùng 1).
# DETECTION_THREADS=0
# DETECTION_MODEL_DIR=.cache/huggingface/hub/models--IDEA-Research--grounding-dino-tiny/snapshots/a2bb814dd30d776dcf7e30523b00659f4f141c71

# --- DRES ---------------------------------------------------------------

# Base URL of the DRES server.
#   local mock DRES (tools/mock_dres.py):  http://localhost:8090
#   a real local DRES instance:            http://localhost:8088
#   inside the docker-compose network:     http://dres:8080
DRES_BASE_URL=http://localhost:8090

# ID of the running evaluation/run in DRES (find it in the DRES admin UI).
# Leave unset/empty for local dev with no evaluation configured -- the app
# then reports "no evaluation" instead of erroring.
DRES_EVALUATION_ID=mock-eval

# Timeout (seconds) for calls to DRES.
# DRES_TIMEOUT_S=5.0

# --- Session / security ---------------------------------------------------

# Random secret used to sign this app's own session cookie (never sent to
# DRES). MUST be set to a real random value in production.
SESSION_SECRET=dev-secret

# true in production (served over HTTPS via Caddy). Set to false only for
# local dev over plain http://127.0.0.1 -- otherwise browsers silently drop
# the cookie.
SESSION_COOKIE_SECURE=false

# --- Request limits (optional, defaults are usually fine) ----------------

# MAX_K=100
# RATE_LIMIT_PER_MIN=30

# Optional Gemini query planning. Keep your key in .env.
# SEARCH_PLAN_API_KEY=
# SEARCH_PLAN_MODEL=gemini-3.5-flash-lite

# --- Question Answering (QA) ---------------------------------------------
# Local QA only: skip DRES login and disable all competition operations.
# Bind the app to 127.0.0.1 when enabling this mode.
# QA_LOCAL_MODE=false
# Enable QA only after configuring its provider.
# QA_ENABLED=false
# QA_RETRIEVAL_ENABLED=false
# Select ONE provider: gemini (API), ollama (local), or openai_compatible.
# Switching QA_PROVIDER preserves the separate Gemini and Ollama settings below.
# QA_PROVIDER=ollama
# QA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# QA_OLLAMA_MODEL=qwen2.5vl:7b
# Số câu QA chạy cùng lúc. 2 phù hợp máy 8 nhân; Grounding DINO vẫn dò lần lượt.
# QA_CONCURRENCY=1
# QA_QUEUE_LIMIT=8
# QA_QUEUE_TIMEOUT_S=3.0
# QA_REQUEST_TIMEOUT_S=30.0
# Time budget for the multi-image reasoning mode, including verification and CLIP crops.
# QA_AUTO_TIMEOUT_S=180
# QA_RATE_LIMIT_PER_MIN=6
# QA_RETRIEVAL_K=10
# QA_MAX_IMAGES=5
# Maximum number of images examined for a corpus-wide QA request (1..1000).
# If the scope is larger or the deadline expires, QA will not claim an exhaustive answer.
# QA_CORPUS_MAX_IMAGES=128
# CLIP crop cosine threshold for grouping the same person/object across images.
# Calibrated with tools/calibrate_distinct_threshold.py (no identity labels needed).
# QA_DISTINCT_SIMILARITY_THRESHOLD=0.76
# Stop reading retrieved images once the evidence already settles the answer.
# QA_EARLY_STOP=true
# How QA decides it has read enough: "rules" (per question type) or "stable_answer"
# (after each 2-image batch ask for a short draft answer; stop when two batches agree).
# QA_EARLY_STOP_MODE=rules
# Number of top-ranked images to inspect for the distinct estimate.
# QA_DISTINCT_TOP_K=10
# QA_CACHE_SIZE=128
# QA_CACHE_TTL_S=600.0
# QA_MAX_OUTPUT_TOKENS=2048

# Gemini alternative (use instead of the Ollama provider/base URL/model above).
# Create your key in Google AI Studio and keep it only in .env/server env.
# QA_ENABLED=true
# QA_PROVIDER=gemini
# QA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# QA_MODEL=gemini-3.5-flash-lite
# QA_API_KEY=
# Optional second key (same model), used when the first hits quota (429) or overload (503).
# QA_API_KEY_BACKUP=
# QA_REQUEST_TIMEOUT_S=60
# QA_MAX_OUTPUT_TOKENS=2048

# Verified ordering catalog for temporal QA; never inferred from filenames.
# QA_SEQUENCE_PATH=data/qa_sequences.json
# QA_PEOPLE_CATALOG_PATH=data/qa_people_reviewed.json
