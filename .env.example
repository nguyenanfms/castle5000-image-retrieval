# =============================================================================
#  MẪU CẤU HÌNH CASTLE5000 — chép thành .env rồi điền giá trị thật
#  (cp .env.example .env). .env bị .gitignore chặn: KHÔNG commit khóa thật.
# =============================================================================
#  - backend/app/config.py tự đọc .env khi khởi động; sửa xong phải khởi động lại server.
#  - Mỗi tham số có: ý nghĩa, [mặc định trong mã | khoảng hợp lệ], và tác dụng khi tăng/giảm.
#  - Xóa hẳn một dòng = quay về giá trị mặc định trong mã. Không ghi một khóa hai lần.
#  - Giá trị ngoài khoảng hợp lệ làm server báo lỗi ngay khi khởi động.
#  - Đường dẫn tương đối tính từ thư mục dự án (nơi chạy uvicorn).
#
#  Mục lục
#    1. Khóa API và mô hình Gemini          5. Grounding DINO (dò đối tượng)
#    2. QA: thời gian và dừng sớm            6. DRES và đăng nhập
#    3. QA: phạm vi đọc ảnh và đếm           7. Dữ liệu, chỉ mục và mô hình nhúng
#    4. KIS: tìm ảnh                         8. Nâng cao / ít khi cần sửa
# =============================================================================


# ---------------------------------------------------------------------------
# 1. KHÓA API VÀ MÔ HÌNH GEMINI
# ---------------------------------------------------------------------------
# Bật/tắt QA. Tắt thì tab Chat không hoạt động, tìm ảnh vẫn chạy.     [false]
QA_ENABLED=true
# Cho QA tự tìm ảnh liên quan (chế độ auto). Tắt thì chỉ hỏi trên ảnh đang mở. [false]
QA_RETRIEVAL_ENABLED=true
# Nhà cung cấp: gemini | ollama (chạy máy) | openai_compatible | mock (để thử)
QA_PROVIDER=gemini
QA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QA_MODEL=gemini-3.5-flash-lite
QA_API_KEY=
# Khóa dự phòng (cùng model), tự dùng lần lượt khi khóa đang dùng hết quota / 503.
# Có thể dùng QA_API_KEY_BACKUP và QA_API_KEY_BACKUP1 ... QA_API_KEY_BACKUP9 (mỗi khóa một project).
QA_API_KEY_BACKUP=
QA_API_KEY_BACKUP1=
QA_API_KEY_BACKUP2=
# Số token tối đa mỗi lần Gemini trả lời. Nhỏ quá thì JSON bị cắt -> phải gọi lại.  [256]
QA_MAX_OUTPUT_TOKENS=2048

# Gemini lập kế hoạch truy vấn cho KIS. Để trống = dùng chung QA_API_KEY khi QA_PROVIDER=gemini.
SEARCH_PLAN_API_KEY=
SEARCH_PLAN_API_KEY_BACKUP=
SEARCH_PLAN_MODEL=gemini-3.5-flash-lite

# Chỉ dùng khi QA_PROVIDER=ollama.
QA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
QA_OLLAMA_MODEL=qwen2.5vl:7b


# ---------------------------------------------------------------------------
# 2. QA: THỜI GIAN VÀ DỪNG SỚM
# ---------------------------------------------------------------------------
# Tổng ngân sách một câu QA tự tìm ảnh (giây), gồm đọc ảnh, phóng to, kiểm và mã hóa crop.
# Tăng nếu hay gặp "hết thời gian" ở câu đếm nhiều ảnh; giảm nếu thi cần trả lời nhanh. [180 | 1–300]
QA_AUTO_TIMEOUT_S=240
# Thời gian chờ một lần gọi Gemini (giây). Tăng khi mạng chậm / hay timeout lẻ.  [60]
QA_REQUEST_TIMEOUT_S=60
# Dừng đọc thêm ảnh khi bằng chứng đã đủ. true = nhanh, tiết kiệm quota; false = đọc hết vòng. [true]
QA_EARLY_STOP=true
# Cách quyết định "đủ": rules (theo loại câu hỏi) | stable_answer (2 lô liên tiếp cùng đáp án,
# mỗi lô tốn thêm 1 lần gọi). Chỉ có tác dụng khi QA_EARLY_STOP=true.               [rules]
QA_EARLY_STOP_MODE=rules


# ---------------------------------------------------------------------------
# 3. QA: PHẠM VI ĐỌC ẢNH VÀ ĐẾM
# ---------------------------------------------------------------------------
# Ngưỡng cosine để coi hai crop là CÙNG một người/vật khi đếm "bao nhiêu người khác nhau".
# Tăng (vd 0.80) -> tách nhiều nhóm hơn, dễ đếm DƯ; giảm (vd 0.70) -> gộp nhiều, dễ đếm THIẾU.
# Ngưỡng thuộc về MÔ HÌNH NHÚNG: đổi EMBED_MODEL_NAME thì chạy lại tools/calibrate_distinct_threshold.py.
#   SigLIP2 (22/11/2026, 8 đoạn / 59 khung): 0.86 sai ~2%; 0.76 đếm THIẾU ~21%.
#   ViT-B-32 cũ: 0.76 dư ~6%.                                                         [0.76 | -1–1]
# Cũng dùng để chọn ảnh có người MỚI khi đếm người khác nhau.
QA_DISTINCT_SIMILARITY_THRESHOLD=0.86
# Số ảnh đầu bảng xét khi đếm đối tượng khác nhau (đọc theo lô 8 ảnh).
# Tăng -> bao phủ rộng hơn nhưng chậm, tốn quota và dễ chạm QA_AUTO_TIMEOUT_S.        [10 | 1–100]
QA_DISTINCT_TOP_K=10
# Số ảnh tối đa khi câu hỏi tính trên toàn bộ tập (vd "ảnh nào nhiều người nhất").
# Phạm vi lớn hơn số này thì QA không khẳng định đã xét hết.                       [128 | 1–1000]
QA_CORPUS_MAX_IMAGES=128
# Kích thước cạnh dài tối đa của ảnh gửi Gemini (px). Lớn -> rõ chi tiết hơn, tốn token hơn. [1024]
QA_IMAGE_MAX_SIDE=1024
# Số crop phóng to tối đa gửi kèm mỗi ảnh.                                           [2]
QA_MAX_CROPS=2


# ---------------------------------------------------------------------------
# 4. KIS: TÌM ẢNH
# ---------------------------------------------------------------------------
# Số kết quả trả về mặc định / tối đa mỗi lần tìm.                                   [50 / 100]
DEFAULT_K=50
MAX_K=100
# Số ảnh đầu bảng (theo CLIP/SigLIP toàn ảnh) được xếp lại bằng vùng và điều kiện.
# Tăng -> ít bỏ sót ảnh đúng nằm sâu, nhưng chậm hơn.                               [100 | 1–500]
SEARCH_CANDIDATE_K=100
# Điểm vùng tối thiểu để coi một chi tiết là "có trong ảnh" (đánh dấu Khớp).
# Phụ thuộc chỉ mục vùng: SigLIP2 ~0.11, RegionCLIP ~0.20. Đổi chỉ mục thì phải đổi số này.
# Tăng -> khắt khe, ít Khớp giả; giảm -> dễ Khớp, nhiều ảnh sai lọt lên.            [0.20 | -1–1]
SEARCH_REGION_THRESHOLD=0.1088
# Trọng số thưởng cho ảnh thỏa chi tiết/điều kiện khi xếp lại. 0 = chỉ dùng thứ hạng CLIP.
# Tăng -> ảnh thỏa điều kiện nhảy lên mạnh hơn.                                      [0.25 | 0–1]
SEARCH_REGION_WEIGHT=0.25
# Số ảnh đầu được Gemini nhìn kiểm sau mỗi lần tìm (4 = 1 lượt kiểm + tối đa 1 lượt phóng to).
# Tăng -> kiểm sâu hơn, chậm và tốn quota hơn.                                       [4 | 1–16]
SEARCH_VERIFY_IMAGES=4
SEARCH_VERIFY_TIMEOUT_S=40.0
SEARCH_PLAN_TIMEOUT_S=20.0


# ---------------------------------------------------------------------------
# 5. GROUNDING DINO (DÒ ĐỐI TƯỢNG THEO TRUY VẤN)
# ---------------------------------------------------------------------------
# Dùng DINO cho điều kiện đếm / "không có X" khi TÌM ẢNH. Chậm trên CPU.
# false: "không có người" chỉ loại được ảnh có vùng người trong chỉ mục, không xác nhận vắng. [false]
# QA đếm khác nhau luôn dùng DINO, không phụ thuộc tham số này.
SEARCH_DETECTION_ENABLED=false
# Số ảnh tối đa được dò mỗi truy vấn.                                                [50 | 1–500]
DETECTION_MAX_IMAGES=50
# Ngân sách mỗi đợt dò (giây).                                                       [45 | ≤300]
DETECTION_TIMEOUT_S=45
# Số luồng CPU khi dò. 0 = số nhân thật (tối đa 8).                                  [0]
DETECTION_THREADS=0
DETECTION_MODEL_DIR=.cache/huggingface/hub/models--IDEA-Research--grounding-dino-tiny/snapshots/a2bb814dd30d776dcf7e30523b00659f4f141c71


# ---------------------------------------------------------------------------
# 6. DRES VÀ ĐĂNG NHẬP
# ---------------------------------------------------------------------------
#   mock cục bộ (tools/mock_dres.py): http://localhost:8090
#   DRES thật cục bộ:                 http://localhost:8088
#   trong docker-compose:             http://dres:8080
DRES_BASE_URL=http://localhost:8090
# ID evaluation đang chạy (lấy trong DRES admin). Để trống = báo "chưa có evaluation".
DRES_EVALUATION_ID=mock-eval
DRES_TIMEOUT_S=5.0
# Hiện lựa chọn "Demo" (mock DRES, student/student) ở màn hình đăng nhập.           [true]
DRES_DEMO_ENABLED=true
# Chỉ hỏi QA cục bộ: bỏ đăng nhập DRES, tắt mọi thao tác nộp bài.                   [false]
QA_LOCAL_MODE=false

# Chuỗi ngẫu nhiên ký cookie phiên. Production phải đặt giá trị thật.
SESSION_SECRET=change-me-to-a-long-random-string
# true khi chạy HTTPS. false cho http://127.0.0.1, nếu không trình duyệt bỏ cookie.  [true]
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=retrieval_session
# Thời gian giữ đăng nhập (giây). 28800 = 8 giờ.
SESSION_MAX_AGE_S=28800


# ---------------------------------------------------------------------------
# 7. DỮ LIỆU, CHỈ MỤC VÀ MÔ HÌNH NHÚNG
# ---------------------------------------------------------------------------
# Thư mục ảnh gốc.
IMAGES_DIR=data/images
INDEX_PATH=data/index.faiss
IDS_PATH=data/ids.json
THUMBS_DIR=data/thumbs
# Mô hình mã hóa văn bản PHẢI khớp với mô hình đã dựng index.faiss.
#   SigLIP 2 (notebooks/Castle5000_SigLIP_Index.ipynb): ViT-SO400M-16-SigLIP2-384 / webli
#   CLIP cũ (tools/build_index.py):                      ViT-B-32 / laion2b_s34b_b79k
EMBED_MODEL_NAME=ViT-SO400M-16-SigLIP2-384
EMBED_PRETRAINED=webli
# Chỉ mục vùng: data/regions-siglip2 (SigLIP2) hoặc data/regions (RegionCLIP).
# Đổi chỉ mục thì xem lại SEARCH_REGION_THRESHOLD ở mục 4.
REGION_INDEX_DIR=data/regions-siglip2
# Khung người (Grounding DINO) + vector crop tính sẵn cho QA: tools/build_person_crops.py hoặc notebook Kaggle
# tools/make_person_crops_notebook.py. Có thư mục này thì QA bỏ qua bước dò và mã hóa cho ảnh đã tính
# (đếm người khác nhau nhanh hơn nhiều). Chưa có thì QA dò lúc hỏi như cũ.
PERSON_CROPS_DIR=data/person-crops
# Tùy chọn, file hiện chưa có. Bỏ # khi có dữ liệu thật:
# METADATA_PATH=data/metadata.csv
QA_SEQUENCE_PATH=data/qa_sequences.json
QA_PEOPLE_CATALOG_PATH=data/qa_people_reviewed.json


# ---------------------------------------------------------------------------
# 8. NÂNG CAO / ÍT KHI CẦN SỬA
# ---------------------------------------------------------------------------
# Tải và giới hạn tần suất
# Số câu QA chạy song song; câu dư phải xếp hàng (tối đa QA_QUEUE_LIMIT, chờ QA_QUEUE_TIMEOUT_S).
QA_CONCURRENCY=2
QA_QUEUE_LIMIT=8
QA_QUEUE_TIMEOUT_S=3.0
# Số câu QA tối đa mỗi phút / số lần tìm ảnh, lập kế hoạch, kiểm ảnh, nộp bài mỗi phút.
QA_RATE_LIMIT_PER_MIN=6
RATE_LIMIT_PER_MIN=30
# Số truy vấn văn bản được mã hóa song song.
ENCODE_CONCURRENCY=4

# Bộ nhớ tạm (số mục / giây sống)
SEARCH_CACHE_SIZE=256
SEARCH_PLAN_CACHE_SIZE=128
QA_CACHE_SIZE=128
QA_CACHE_TTL_S=600.0

# Độ dài tối đa câu truy vấn / câu hỏi (ký tự)
QUERY_MAX_LEN=1200
QA_QUESTION_MAX_LEN=1200

# Chế độ retrieval_qa cũ (chế độ auto hiện tại không dùng các khóa này)
QA_RETRIEVAL_K=10
QA_MAX_IMAGES=5
QA_RETRIEVAL_STRATEGY=verified_early_stop
QA_CONFIRM_CANDIDATES=1

# Đổi phiên bản để vô hiệu hóa bộ nhớ tạm QA cũ khi sửa prompt/chính sách.
QA_PROMPT_VERSION=qa-v1
QA_POLICY_VERSION=policy-v1
