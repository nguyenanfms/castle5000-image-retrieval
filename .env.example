# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets or credentials.
#
# Settings are read automatically from .env by backend/app/config.py
# (pydantic-settings, env_file=".env") -- you don't need to export these by
# hand or pass them inline on the uvicorn command line.

# Paths can be relative to the repo root when the app starts there.
# IMAGES_DIR=../data
# INDEX_PATH=data/index.faiss
# IDS_PATH=data/ids.json
# REGION_INDEX_DIR=data/regions

# --- DRES ---------------------------------------------------------------

# Base URL of the DRES server.
#   local mock DRES (tools/mock_dres.py):  http://localhost:8090
#   a real local DRES instance:            http://localhost:8088
#   inside the docker-compose network:     http://dres:8080
DRES_BASE_URL=http://localhost:8090

# ID of the running evaluation/run in DRES (find it in the DRES admin UI).
# Leave unset/empty for local dev with no evaluation configured -- the app
# then reports "no evaluation" instead of erroring.
DRES_EVALUATION_ID=mock-eval

# Timeout (seconds) for calls to DRES.
# DRES_TIMEOUT_S=5.0

# --- Session / security ---------------------------------------------------

# Random secret used to sign this app's own session cookie (never sent to
# DRES). MUST be set to a real random value in production.
SESSION_SECRET=dev-secret

# true in production (served over HTTPS via Caddy). Set to false only for
# local dev over plain http://127.0.0.1 -- otherwise browsers silently drop
# the cookie.
SESSION_COOKIE_SECURE=false

# --- Request limits (optional, defaults are usually fine) ----------------

# MAX_K=100
# RATE_LIMIT_PER_MIN=30

# Optional Gemini query planning. Keep your key in .env.
# SEARCH_PLAN_API_KEY=
# SEARCH_PLAN_MODEL=gemini-3.5-flash-lite

# --- Question Answering (QA) ---------------------------------------------
# Local QA only: skip DRES login and disable all competition operations.
# Bind the app to 127.0.0.1 when enabling this mode.
# QA_LOCAL_MODE=false
# Enable QA only after configuring its provider.
# QA_ENABLED=false
# QA_RETRIEVAL_ENABLED=false
# QA_PROVIDER=openai_compatible
# QA_BASE_URL=http://127.0.0.1:11434/v1
# QA_API_KEY=
# QA_MODEL=qwen2.5vl:7b
# QA_CONCURRENCY=1
# QA_QUEUE_LIMIT=8
# QA_QUEUE_TIMEOUT_S=3.0
# QA_REQUEST_TIMEOUT_S=30.0
# QA_RATE_LIMIT_PER_MIN=6
# QA_RETRIEVAL_K=10
# QA_MAX_IMAGES=5
# QA_CACHE_SIZE=128
# QA_CACHE_TTL_S=600.0
# QA_MAX_OUTPUT_TOKENS=256

# Gemini alternative (use instead of the Ollama provider/base URL/model above).
# Create your key in Google AI Studio and keep it only in .env/server env.
# QA_ENABLED=true
# QA_PROVIDER=gemini
# QA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# QA_MODEL=gemini-3.5-flash-lite
# QA_API_KEY=
# QA_REQUEST_TIMEOUT_S=60
# QA_MAX_OUTPUT_TOKENS=2048

# Verified ordering catalog for temporal QA; never inferred from filenames.
# QA_SEQUENCE_PATH=data/qa_sequences.json
# QA_PEOPLE_CATALOG_PATH=data/qa_people_reviewed.json
